# Copy this file to backend/.env and fill in the real values. Never commit .env.

# Postgres with the pgvector extension. Replace USER, PASSWORD and the database name.
# A password with special characters (@ : / #) must be URL-encoded.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/RAG

# LLM keys. Groq is tried first; Gemini is used if Groq fails or has no key.
GROQ_API_KEY=
GEMINI_API_KEY=
